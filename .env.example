RALLYCLIP_FIREBASE_PROJECT=your-firebase-project
RALLYCLIP_FIRESTORE_DATABASE=(default)
RALLYCLIP_FIRESTORE_PREFIX=rallyclip
RALLYCLIP_ARTIFACT_BUCKET=your-r2-bucket
RALLYCLIP_R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
RALLYCLIP_R2_ACCESS_KEY_ID=
RALLYCLIP_R2_SECRET_ACCESS_KEY=
# Optional custom public URL whose path maps to the root of this same R2 bucket.
RALLYCLIP_R2_PUBLIC_BASE_URL=
# Trusted server-to-server token; never embed this in a browser application.
RALLYCLIP_ANALYSIS_API_TOKEN=
RALLYCLIP_API_TOKEN=
RALLYCLIP_REQUIRE_USER_AUTH=1
# Firestore uses Google Application Default Credentials (ADC).
GOOGLE_APPLICATION_CREDENTIALS=C:/secrets/service-account.json
